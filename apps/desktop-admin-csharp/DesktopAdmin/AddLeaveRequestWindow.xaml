<Window x:Class="DesktopAdmin.AddLeaveRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj wniosek"
        Height="320"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Użytkownik" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="UserComboBox" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Typ urlopu" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LeaveTypeComboBox" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Okres urlopu" VerticalAlignment="Center" Margin="0,0,0,8" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <DatePicker x:Name="StartDatePicker" Width="150" Margin="0,0,10,0" />
            <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,10,0" />
            <DatePicker x:Name="EndDatePicker" Width="150" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Powód" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ReasonTextBox" Margin="0,0,0,8" />

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="CancelButton" Content="Anuluj" Style="{StaticResource NeutralButtonStyle}" Width="100" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Dodaj" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
