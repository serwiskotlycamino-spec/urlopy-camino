<Window x:Class="DesktopAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="System Urlopowy Camino 1.1.2 - Panel Administratora"
        Height="860"
        Width="1320"
        MinHeight="720"
        MinWidth="1100">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   Text="Panel Administratora"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

            <Button Grid.Column="1"
                x:Name="CalendarButton"
                Content="Kalendarz"
                Style="{StaticResource InfoButtonStyle}"
                Width="120"
                Margin="0,0,8,0"
                Click="CalendarButton_Click" />

            <Button Grid.Column="2"
                x:Name="MontageButton"
                Content="Montaże"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="120"
                Margin="0,0,8,0"
                Click="MontageButton_Click" />

            <Button Grid.Column="3"
                x:Name="OptionsButton"
                Content="Opcje"
                Style="{StaticResource InfoButtonStyle}"
                Width="110"
                Margin="0,0,8,0"
                Click="OptionsButton_Click" />

            <Button Grid.Column="4"
                x:Name="LogoutButton"
                Content="Wyloguj"
                Style="{StaticResource NeutralButtonStyle}"
                Width="110"
                Margin="0,0,8,0"
                Click="LogoutButton_Click" />

            <Button Grid.Column="5"
                x:Name="CloseButton"
                Content="Zamknij"
                Style="{StaticResource DangerButtonStyle}"
                Width="100"
                Click="CloseButton_Click" />
        </Grid>

        <Border x:Name="LoginPanel"
            Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Email" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" x:Name="EmailTextBox" Margin="8,0,10,0" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Hasło" FontWeight="SemiBold" />
                <PasswordBox Grid.Column="3" x:Name="PasswordBox" Margin="8,0,10,0" />

                <Button Grid.Column="4" x:Name="LoginButton" Content="Zaloguj" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" />
                <TextBlock Grid.Column="5" x:Name="CurrentUserTextBlock" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#444" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="MainTabs" IsEnabled="False">
            <TabItem Header="Wszystkie wnioski">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="RequestsGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              SelectionChanged="PendingGrid_SelectionChanged"
                              MouseDoubleClick="RequestsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Pracownik" Binding="{Binding UserName}" Width="150" />
                            <DataGridTextColumn Header="Złożono" Binding="{Binding CreatedAtDisplay}" SortMemberPath="CreatedAtValue" Width="145" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding LeaveTypePl}" Width="120" />
                            <DataGridTextColumn Header="Od" Binding="{Binding StartDateOnly}" Width="110" />
                            <DataGridTextColumn Header="Do" Binding="{Binding EndDateOnly}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="110" />
                            <DataGridTextColumn Header="Notatka pracownika" Binding="{Binding Reason}" Width="200" />
                            <DataGridTextColumn Header="Komentarz szefa" Binding="{Binding ManagerComment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Komentarz decyzji" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox x:Name="DecisionCommentTextBox" Width="500" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="RefreshPendingButton" Content="Odśwież" Width="110" Style="{StaticResource InfoButtonStyle}" Click="RefreshPendingButton_Click" />
                        <Button x:Name="AddLeaveButton" Content="Dodaj wniosek" Width="140" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddLeaveButton_Click" />
                        <Button x:Name="ApproveButton" Content="Akceptuj" Width="110" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ApproveButton_Click" />
                        <Button x:Name="RejectButton" Content="Odrzuć" Width="110" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="RejectButton_Click" />
                        <Button x:Name="SaveCommentButton" Content="Zapisz komentarz" Width="130" Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}" Click="SaveCommentButton_Click" />
                        <Button x:Name="DeleteLeaveButton" Content="Usuń" Width="110" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteLeaveButton_Click" />
                        <Button x:Name="ArchiveLeaveButton" Content="Przenieś do archiwum" Width="160" Margin="10,0,0,0" Style="{StaticResource NeutralButtonStyle}" Click="ArchiveLeaveButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Archiwum">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ArchiveGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Pracownik" Binding="{Binding UserName}" Width="150" />
                            <DataGridTextColumn Header="Złożono" Binding="{Binding CreatedAtDisplay}" SortMemberPath="CreatedAtValue" Width="145" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding LeaveTypePl}" Width="120" />
                            <DataGridTextColumn Header="Od" Binding="{Binding StartDateOnly}" Width="110" />
                            <DataGridTextColumn Header="Do" Binding="{Binding EndDateOnly}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="110" />
                            <DataGridTextColumn Header="Komentarz szefa" Binding="{Binding ManagerComment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="RestoreFromArchiveButton" Content="Przywróć do listy" Width="170" Style="{StaticResource PrimaryButtonStyle}" Click="RestoreFromArchiveButton_Click" />
                        <Button x:Name="DeleteFromArchiveButton" Content="Usuń z archiwum" Width="170" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteFromArchiveButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Użytkownicy">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              SelectionChanged="UsersGrid_SelectionChanged"
                              MouseDoubleClick="UsersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Imię" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="280" />
                            <DataGridTextColumn Header="Rola" Binding="{Binding RolePl}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Imię" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="NewUserNameTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="2" Text="Email" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" x:Name="NewUserEmailTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="4" Text="Hasło" VerticalAlignment="Center" />
                            <TextBox Grid.Column="5" x:Name="NewUserPasswordTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="6" Text="Rola" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="7" x:Name="NewUserRoleCombo" Margin="6,0,10,0" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="RefreshUsersButton" Content="Odśwież" Width="110" Style="{StaticResource InfoButtonStyle}" Click="RefreshUsersButton_Click" />
                        <Button x:Name="CreateUserButton" Content="Dodaj użytkownika" Width="150" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="CreateUserButton_Click" />
                        <Button x:Name="DeleteUserButton" Content="Usuń użytkownika" Width="150" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteUserButton_Click" />
                        <TextBlock Text="Zmień rolę dla zaznaczonego:" VerticalAlignment="Center" Margin="20,0,8,0" />
                        <ComboBox x:Name="UpdateRoleCombo" Width="120" />
                        <Button x:Name="UpdateRoleButton" Content="Zmień rolę" Width="120" Margin="8,0,0,0" Style="{StaticResource InfoButtonStyle}" Click="UpdateRoleButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Wyjazdy służbowe">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="WorkTripsGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              MouseDoubleClick="WorkTripsGrid_MouseDoubleClick"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Pracownik" Binding="{Binding UserName}" Width="150" />
                            <DataGridTextColumn Header="Data" Binding="{Binding TripDatePl}" Width="110" />
                            <DataGridTextColumn Header="Od" Binding="{Binding StartTime}" Width="110" />
                            <DataGridTextColumn Header="Do" Binding="{Binding EndTime}" Width="110" />
                            <DataGridTextColumn Header="Cel" Binding="{Binding Destination}" Width="200" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="110" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Pracownik:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="WorkTripUserComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="2" Text="Data:" VerticalAlignment="Center" />
                            <DatePicker Grid.Column="3" x:Name="WorkTripDatePicker" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="4" Text="Od:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="5" x:Name="WorkTripStartTextBox" Margin="6,0,10,0" />
                            
                            <TextBlock Grid.Column="6" Text="Do:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="7" x:Name="WorkTripEndTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="8" Text="Cel:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="9" x:Name="WorkTripDestinationTextBox" Margin="6,0,10,0" />
                        </Grid>
                    </Border>
                    
                    <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                         <Grid>
                            <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="80" />
                               <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Opis:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="WorkTripDescriptionTextBox" Margin="6,0,10,0" />
                        </Grid>
                    </Border>
                    
                     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Podwójny klik w wiersz otwiera pełną edycję wyjazdu." VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button x:Name="RefreshWorkTripsButton" Content="Odśwież" Width="110" Style="{StaticResource InfoButtonStyle}" Click="RefreshWorkTripsButton_Click" />
                        <Button x:Name="AddWorkTripButton" Content="Dodaj wyjazd" Width="120" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddWorkTripButton_Click" />
                        <Button x:Name="UpdateWorkTripButton" Content="Zapisz zmiany" Width="120" Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}" Click="UpdateWorkTripButton_Click" />
                        <Button x:Name="ReviewWorkTripButton" Content="Akceptuj/Odrzuć" Width="150" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ReviewWorkTripButton_Click" />
                        <Button x:Name="DeleteWorkTripButton" Content="Usuń wyjazd" Width="120" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteWorkTripButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Historia i podliczenia">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Użytkownicy" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1"
                                     x:Name="HistoryUsersList"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="HistoryUsersList_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="HistoryUserHeaderText" Text="Wybierz użytkownika z listy." FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Imię i nazwisko" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HistoryNameTextBox" Margin="8,0,16,8" IsReadOnly="True" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Email" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="HistoryEmailTextBox" Margin="8,0,0,8" IsReadOnly="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rola" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="HistoryRoleTextBox" Margin="8,0,16,8" IsReadOnly="True" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Telefon" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="HistoryPhoneTextBox" Margin="8,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Adres" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="HistoryAddressTextBox" Margin="8,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dodatkowe dane" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="HistoryNotesTextBox" Margin="8,0,0,0" />
                            </Grid>

                            <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ilość zgłoszeń" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="StatsTotalRequestsText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Aktualnie przetwarzane" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="StatsPendingRequestsText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Zgłoszenia zatwierdzone" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="StatsApprovedRequestsText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Zgłoszenia odrzucone" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="StatsRejectedRequestsText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Zgłoszenia anulowane" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="StatsCancelledRequestsText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Wykorzystany urlop roczny" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="StatsAnnualUsedText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Wykorzystane na żądanie" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="StatsOnDemandUsedText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Pozostały urlop" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="StatsRemainingLeaveText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Wykorzystane chorobowe" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="StatsSickUsedText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Wyjazdy służbowe (łącznie)" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="StatsTripsTotalText" IsReadOnly="True" Margin="6,0,0,4" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Wyjazdy służbowe (przetwarzane)" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="StatsTripsPendingText" IsReadOnly="True" Margin="6,0,0,0" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="3"
                                      x:Name="HistoryRecentGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MouseDoubleClick="HistoryRecentGrid_MouseDoubleClick"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Typ" Binding="{Binding LeaveTypePl}" Width="140" />
                                    <DataGridTextColumn Header="Od" Binding="{Binding StartDateOnly}" Width="120" />
                                    <DataGridTextColumn Header="Do" Binding="{Binding EndDateOnly}" Width="120" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="120" />
                                    <DataGridTextColumn Header="Komentarz" Binding="{Binding ManagerComment}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <TextBlock Text="Roczny limit urlopu" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="AnnualLimitTextBox" Width="90" Margin="0,0,8,0" />
                                <Button x:Name="SaveAnnualLimitButton" Content="Zapisz limit" Width="120" Style="{StaticResource InfoButtonStyle}" Click="SaveAnnualLimitButton_Click" />
                                <Button x:Name="EditHistoryUserButton" Content="Edytuj" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="EditHistoryUserButton_Click" />
                                <Button x:Name="UserHistoryButton" Content="Historia" Width="120" Style="{StaticResource InfoButtonStyle}" Click="UserHistoryButton_Click" />
                                <Button x:Name="ExportUserPdfButton" Content="Eksportuj PDF" Width="140" Style="{StaticResource InfoButtonStyle}" Click="ExportUserPdfButton_Click" />
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Gotowy." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
