<Window x:Class="DesktopAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="System Urlopowy Camino - Panel Administratora"
        Height="860"
        Width="1320"
        MinHeight="720"
        MinWidth="1100">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   Text="Panel Administratora"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

            <Button Grid.Column="1"
                x:Name="LogoutButton"
                Content="Wyloguj"
                Width="110"
                Margin="0,0,8,0"
                Click="LogoutButton_Click" />

            <Button Grid.Column="2"
                x:Name="CloseButton"
                Content="Zamknij"
                Width="100"
                Click="CloseButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="API URL" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" x:Name="ApiUrlTextBox" Margin="10,0,10,0" />
                <Button Grid.Column="2" x:Name="ApplyApiButton" Content="Ustaw API" Click="ApplyApiButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="LoginPanel"
            Grid.Row="2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Email" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" x:Name="EmailTextBox" Margin="8,0,10,0" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Hasło" FontWeight="SemiBold" />
                <PasswordBox Grid.Column="3" x:Name="PasswordBox" Margin="8,0,10,0" />

                <Button Grid.Column="4" x:Name="LoginButton" Content="Zaloguj" Click="LoginButton_Click" />
                <TextBlock Grid.Column="5" x:Name="CurrentUserTextBlock" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#444" />
            </Grid>
        </Border>

        <TabControl Grid.Row="3" x:Name="MainTabs" IsEnabled="False">
            <TabItem Header="Wnioski oczekujące">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="PendingGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              SelectionChanged="PendingGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="ID Pracownika" Binding="{Binding UserId}" Width="95" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding LeaveType}" Width="120" />
                            <DataGridTextColumn Header="Od" Binding="{Binding StartDate}" Width="110" />
                            <DataGridTextColumn Header="Do" Binding="{Binding EndDate}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Komentarz decyzji" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox x:Name="DecisionCommentTextBox" Width="500" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="RefreshPendingButton" Content="Odśwież" Width="110" Click="RefreshPendingButton_Click" />
                        <Button x:Name="ApproveButton" Content="Akceptuj" Width="110" Margin="10,0,0,0" Click="ApproveButton_Click" />
                        <Button x:Name="RejectButton" Content="Odrzuć" Width="110" Margin="10,0,0,0" Click="RejectButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Użytkownicy">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="UsersGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              SelectionChanged="UsersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Imię" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="280" />
                            <DataGridTextColumn Header="Rola" Binding="{Binding Role}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Imię" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="NewUserNameTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="2" Text="Email" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" x:Name="NewUserEmailTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="4" Text="Hasło" VerticalAlignment="Center" />
                            <TextBox Grid.Column="5" x:Name="NewUserPasswordTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="6" Text="Rola" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="7" x:Name="NewUserRoleCombo" Margin="6,0,10,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Edycja:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            
                            <TextBlock Grid.Column="0" Text="Imię" VerticalAlignment="Center" Margin="55,0,0,0"/>
                            <TextBox Grid.Column="1" x:Name="EditUserNameTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="2" Text="Email" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" x:Name="EditUserEmailTextBox" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="4" Text="Hasło" VerticalAlignment="Center" />
                            <TextBox Grid.Column="5" x:Name="EditUserPasswordTextBox" Margin="6,0,10,0" />

                            <Button Grid.Column="6" x:Name="UpdateUserButton" Content="Zapisz zmiany" Width="100" HorizontalAlignment="Left" Click="UpdateUserButton_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="RefreshUsersButton" Content="Odśwież" Width="110" Click="RefreshUsersButton_Click" />
                        <Button x:Name="CreateUserButton" Content="Dodaj użytkownika" Width="150" Margin="10,0,0,0" Click="CreateUserButton_Click" />
                        <Button x:Name="DeleteUserButton" Content="Usuń użytkownika" Width="150" Margin="10,0,0,0" Click="DeleteUserButton_Click" />
                        <TextBlock Text="Zmień rolę dla zaznaczonego:" VerticalAlignment="Center" Margin="20,0,8,0" />
                        <ComboBox x:Name="UpdateRoleCombo" Width="120" />
                        <Button x:Name="UpdateRoleButton" Content="Zmień rolę" Width="120" Margin="8,0,0,0" Click="UpdateRoleButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Ustawienia mail">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP host" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmtpHostTextBox" Margin="8,0,20,8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="SMTP port" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="SmtpPortTextBox" Margin="8,0,20,8" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="SMTP user" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="5" x:Name="SmtpUserTextBox" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SMTP from" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SmtpFromTextBox" Margin="8,0,20,8" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="IMAP host" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ImapHostTextBox" Margin="8,0,20,8" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="IMAP port" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="5" x:Name="ImapPortTextBox" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAP user" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ImapUserTextBox" Margin="8,0,20,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Tryb" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="3" x:Name="CommunicationModeCombo" Margin="8,0,20,0" />
                        <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" x:Name="ImapSecureCheck" Content="IMAP secure" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Hasło SMTP" VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="1" x:Name="SmtpPassBox" Margin="8,0,20,0" />
                        <TextBlock Grid.Column="2" Text="Hasło IMAP" VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="3" x:Name="ImapPassBox" Margin="8,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="RefreshMailButton" Content="Odśwież" Width="110" Click="RefreshMailButton_Click" />
                        <Button x:Name="SaveMailButton" Content="Zapisz ustawienia" Width="150" Margin="10,0,0,0" Click="SaveMailButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Gotowy." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
