<Window x:Class="DesktopAdmin.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urlopy Camino - Panel szefa"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   x:Name="HeaderTextBlock"
                   Text="Panel szefa"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

            <Button Grid.Column="1"
                x:Name="LogoutButton"
                Content="Wyloguj"
                Width="110"
                Margin="0,0,8,0"
                Click="LogoutButton_Click" />

            <Button Grid.Column="2"
                x:Name="CloseButton"
                Content="Zamknij"
                Width="100"
                Click="CloseButton_Click" />
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="ApiInfoTextBlock"
                   Foreground="#666"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="2"
                  x:Name="PendingGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="0,0,0,10"
                  SelectionChanged="PendingGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                <DataGridTextColumn Header="Pracownik ID" Binding="{Binding UserId}" Width="110" />
                <DataGridTextColumn Header="Typ" Binding="{Binding LeaveType}" Width="120" />
                <DataGridTextColumn Header="Od" Binding="{Binding StartDate}" Width="110" />
                <DataGridTextColumn Header="Do" Binding="{Binding EndDate}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Powod" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Komentarz decyzji" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" x:Name="DecisionCommentTextBox" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="RefreshButton" Content="Odswiez" Width="120" Click="RefreshButton_Click" />
            <Button x:Name="ApproveButton" Content="Akceptuj" Width="120" Margin="10,0,0,0" Click="ApproveButton_Click" />
            <Button x:Name="RejectButton" Content="Odrzuc" Width="120" Margin="10,0,0,0" Click="RejectButton_Click" />
            <TextBlock x:Name="StatusTextBlock" Margin="16,8,0,0" Foreground="#444" />
        </StackPanel>
    </Grid>
</Window>
