<Window x:Class="DesktopAdmin.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opcje programu - System Urlopowy Camino 1.1.2"
        Height="540"
        Width="860"
        MinHeight="460"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Rejestr zmian">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="System Urlopowy Camino 1.1.2"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBox Grid.Row="1"
                             x:Name="ChangeLogTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="API">
                <Border Padding="12" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API URL" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiUrlTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Zmiana adresu API wymaga ponownego logowania w panelu głównym."
                                   Foreground="#555"
                                   Margin="0,0,0,12" />

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="SaveApiButton" Content="Zapisz API" Width="130" Style="{StaticResource InfoButtonStyle}" Click="SaveApiButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Dane wspólne">
                <Border Padding="12" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Katalog danych" VerticalAlignment="Center" Margin="0,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StoragePathTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Wskaż wspólny katalog (np. OneDrive), aby wszystkie komputery używały tych samych plików bazy i konfiguracji."
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BrowseStorageButton" Content="Wybierz folder" Width="130" Style="{StaticResource NeutralButtonStyle}" Click="BrowseStorageButton_Click" />
                            <Button x:Name="UseOneDriveButton" Content="Użyj OneDrive" Width="130" Style="{StaticResource InfoButtonStyle}" Click="UseOneDriveButton_Click" />
                            <Button x:Name="SaveStorageButton" Content="Zapisz katalog" Width="130" Style="{StaticResource PrimaryButtonStyle}" Click="SaveStorageButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Dane firmy">
                <Border Padding="12" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa firmy" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CompanyNameTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Adres" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompanyAddressTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="NIP" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompanyTaxIdTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefon" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CompanyPhoneTextBox" Margin="8,0,0,10" />

                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="SaveCompanyButton" Content="Zapisz dane firmy" Width="170" Style="{StaticResource PrimaryButtonStyle}" Click="SaveCompanyButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Adres email">
                <Border Padding="12" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Adres Gmail" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="GmailAddressTextBox" Margin="8,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hasło do emaila" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,10">
                            <PasswordBox x:Name="GmailPasswordBox" Width="240" />
                            <TextBox x:Name="GmailPasswordVisibleTextBox" Width="240" Visibility="Collapsed" Margin="0,0,0,0" />
                            <Button x:Name="TogglePasswordButton" Content="Pokaż" Width="60" Style="{StaticResource NeutralButtonStyle}" Click="TogglePasswordButton_Click" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Używamy konta Gmail do obsługi wysyłki i odbioru w programie."
                                   Foreground="#555"
                                   Margin="0,0,0,12" />

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="RefreshEmailButton" Content="Odśwież" Width="120" Style="{StaticResource InfoButtonStyle}" Click="RefreshEmailButton_Click" />
                            <Button x:Name="SaveEmailButton" Content="Zapisz email" Width="140" Style="{StaticResource PrimaryButtonStyle}" Click="SaveEmailButton_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="W przyszłości dodamy tutaj kolejne opcje programu."
                                   Foreground="#555"
                                   Margin="0,10,0,0" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Kosz">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TrashGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="Pracownik" Binding="{Binding UserName}" Width="180" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding LeaveTypePl}" Width="130" />
                            <DataGridTextColumn Header="Od" Binding="{Binding StartDateOnly}" Width="100" />
                            <DataGridTextColumn Header="Do" Binding="{Binding EndDateOnly}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="120" />
                            <DataGridTextColumn Header="Skąd" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="Usunięto" Binding="{Binding DeletedAt}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="1">
                        <Button x:Name="RefreshTrashButton" Content="Odśwież" Width="110" Style="{StaticResource InfoButtonStyle}" Click="RefreshTrashButton_Click" />
                        <Button x:Name="RestoreSelectedTrashButton" Content="Przywróć zaznaczone" Width="150" Style="{StaticResource PrimaryButtonStyle}" Click="RestoreSelectedTrashButton_Click" />
                        <Button x:Name="RestoreAllTrashButton" Content="Przywróć wszystko" Width="140" Style="{StaticResource PrimaryButtonStyle}" Click="RestoreAllTrashButton_Click" />
                        <Button x:Name="DeleteSelectedTrashButton" Content="Usuń zaznaczone" Width="150" Style="{StaticResource DangerButtonStyle}" Click="DeleteSelectedTrashButton_Click" />
                        <Button x:Name="ClearTrashButton" Content="Opróżnij kosz" Width="130" Style="{StaticResource DangerButtonStyle}" Click="ClearTrashButton_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#444" />
            <Button DockPanel.Dock="Right" Content="Zamknij" Width="120" Style="{StaticResource NeutralButtonStyle}" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
