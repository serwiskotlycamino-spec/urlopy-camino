<Window x:Class="DesktopAdmin.LeaveRequestDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decyzja wniosku"
        Height="260"
        Width="460"
        MinHeight="240"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Komentarz do decyzji"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <TextBox Grid.Row="1"
                 x:Name="CommentTextBox"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Przyjmij" Width="100" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="ApproveButton_Click" />
            <Button Content="Odrzuć" Width="100" Margin="0,0,10,0" Style="{StaticResource DangerButtonStyle}" Click="RejectButton_Click" />
            <Button Content="Anuluj" Width="100" Style="{StaticResource NeutralButtonStyle}" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>