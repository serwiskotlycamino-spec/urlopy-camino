<Window x:Class="DesktopAdmin.UserHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historia użytkownika"
        Height="520"
        Width="900"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <DataGrid Grid.Row="1"
                  x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt}" Width="200" />
                <DataGridTextColumn Header="Akcja" Binding="{Binding Action}" Width="220" />
                <DataGridTextColumn Header="Szczegóły" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Eksportuj PDF" Width="140" Style="{StaticResource InfoButtonStyle}" Click="ExportPdfButton_Click" />
            <Button Content="Zamknij" Width="120" Style="{StaticResource NeutralButtonStyle}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
