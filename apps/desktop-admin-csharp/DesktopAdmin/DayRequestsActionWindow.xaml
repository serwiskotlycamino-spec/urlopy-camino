<Window x:Class="DesktopAdmin.DayRequestsActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wnioski z dnia"
        Height="560"
        Width="980"
        MinHeight="480"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="1"
                  x:Name="RequestsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Pracownik" Binding="{Binding UserName}" Width="160" />
                <DataGridTextColumn Header="Typ" Binding="{Binding LeaveTypePl}" Width="140" />
                <DataGridTextColumn Header="Od" Binding="{Binding StartDateOnly}" Width="110" />
                <DataGridTextColumn Header="Do" Binding="{Binding EndDateOnly}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusPl}" Width="110" />
                <DataGridTextColumn Header="Notatka" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Komentarz" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" x:Name="CommentTextBox" Height="30" VerticalContentAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApproveButton" Content="Zatwierdź" Width="120" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="ApproveButton_Click" />
            <Button x:Name="RejectButton" Content="Odrzuć" Width="120" Margin="0,0,10,0" Style="{StaticResource DangerButtonStyle}" Click="RejectButton_Click" />
            <Button x:Name="EditButton" Content="Edytuj" Width="120" Margin="0,0,10,0" Style="{StaticResource InfoButtonStyle}" Click="EditButton_Click" />
            <Button x:Name="AddButton" Content="Dodaj nowy" Width="120" Margin="0,0,10,0" Style="{StaticResource NeutralButtonStyle}" Click="AddButton_Click" />
            <Button x:Name="CloseButton" Content="Zamknij" Width="120" Style="{StaticResource NeutralButtonStyle}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
