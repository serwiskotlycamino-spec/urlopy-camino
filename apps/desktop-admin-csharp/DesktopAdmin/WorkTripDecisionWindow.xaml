<Window x:Class="DesktopAdmin.WorkTripDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decyzja wyjazdu"
        Height="260"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notatka zwrotna do użytkownika" FontWeight="SemiBold" Margin="0,0,0,8" />

        <TextBox Grid.Row="1" x:Name="CommentTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Akceptuj" Width="100" Style="{StaticResource PrimaryButtonStyle}" Click="ApproveButton_Click" />
            <Button Content="Odrzuć" Width="100" Style="{StaticResource DangerButtonStyle}" Click="RejectButton_Click" />
            <Button Content="Anuluj" Width="100" Style="{StaticResource NeutralButtonStyle}" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
