<Window x:Class="DesktopAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urlopy Camino - Logowanie"
        Height="360"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Logowanie do systemu urlopowego"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="API URL" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" x:Name="ApiUrlTextBox" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Email" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" x:Name="EmailTextBox" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Haslo" FontWeight="SemiBold" />
            <PasswordBox Grid.Column="1" x:Name="PasswordBox" />
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="ErrorTextBlock"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   MinHeight="22"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SwitchAccountButton"
                    Content="Zmień konto"
                    Width="140"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="SwitchAccountButton_Click" />
            <Button x:Name="LoginButton"
                    Content="Zaloguj"
                    Width="140"
                    Height="34"
                    Click="LoginButton_Click" />
        </StackPanel>
    </Grid>
</Window>
