{
  "name": "program-urlopowy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web-admin run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:mobile": "npm --workspace apps/mobile-worker run start",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
